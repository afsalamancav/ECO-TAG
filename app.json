{
  "expo": {
    "name": "EcoTag",
    "slug": "EcoTag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ecotag",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NFCReaderUsageDescription": "EcoTag utiliza NFC para identificar y rastrear los textiles del hotel.",
        "NSCameraUsageDescription": "EcoTag necesita acceso a la cámara para escanear los códigos QR de las habitaciones.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.afsalamancav.EcoTag"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#1B4D21"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.afsalamancav.EcoTag",
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-sqlite",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "EcoTag necesita acceso al NFC para leer los chips de las prendas.",
          "selectIdentifiers": [
            "D2760000850101"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "EcoTag necesita acceso a la cámara para escanear los códigos QR de las habitaciones."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa74575e-dde3-49a0-aa0f-99853a7a33d2"
      }
    },
    "owner": "afsalamancav"
  }
}